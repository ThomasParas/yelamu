.DS_Store
__pycache__/
*.pyc
pipeline/.venv/
pipeline/data/raw/
# A symlink to the raw data (used by git worktrees) is not matched by the line above.
pipeline/data/raw
.claude/worktrees/
viewer/node_modules/
viewer/dist/

# The built real-city data is tracked: it derives from GPL-3.0-or-later SFEI data and public sources (NOTICE.md).
# Older local experiments and review images stay out of git.
viewer/public/assets/real/
docs/research/local/
# Outreach drafts and call scripts (emails to SFEI or the Association of Ramaytush Ohlone) stay out of git:
# keep them in docs/research/local/. Records of what others replied (sfei-license-reply.md) are tracked.
docs/research/*-draft.md
docs/research/*-script.md
.playwright-mcp/

# Generated synthetic whole-city test data (no real data in it, but 8 MB of binary)
viewer/public/assets/city-synth/
