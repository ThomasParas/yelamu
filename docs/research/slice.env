# Consumed by Task 12. Every value comes from docs/research/2026-data-sources.md.
#
# Test box (lon/lat): west -122.42, south 37.755, east -122.37, north 37.805.
#
# DEM_URL: one GeoTIFF that covers the whole box. USGS 3DEP 1/3 arc-second (about 10 m),
#   CRS EPSG:4269 (NAD83 geographic), 222,936,410 bytes. The box is inside this 1x1 degree tile.
#   (Optional finer alternative, NOT used here because it takes two files: USGS 1 m tiles
#   x55y418 and x55y419 of CA_SanFrancisco_B23, EPSG:26910. URLs are in the research note.)
export DEM_URL="https://prd-tnm.s3.amazonaws.com/StagedProducts/Elevation/13/TIFF/current/n38w123/USGS_13_n38w123.tif"

# SFEI_URL: query URL on SFEI's public ArcGIS Online feature service "San Francisco Historical
#   Habitats" (Hidden Nature SF, 2021). Returns all 450 polygons as GeoJSON (EPSG:4326, about 3.9 MB).
#   Use `curl -L "$SFEI_URL" -o sf_habitats.geojson`. The service's native CRS is EPSG:3310.
#   LICENSE NOT STATED on this layer: see Decision in 2026-data-sources.md before any public release.
export SFEI_URL="https://services1.arcgis.com/8V9ShUQ1DGYVLtOg/arcgis/rest/services/Historical_habitats_dissolved_v3/FeatureServer/1/query?where=1%3D1&outFields=*&outSR=4326&f=geojson"

# SFEI_LAYER: layer name on the service (FeatureServer layer id 1). A GeoJSON download has a
#   single unnamed collection, so this is informational for the GeoJSON path.
export SFEI_LAYER="Historical habitats dissolved"

# HABITAT_FIELD: string field (width 150) holding the habitat class. Values verified by a
#   distinct-values query against the service (31 values).
export HABITAT_FIELD="HabitatCla"

# BAY_VALUES: open bay / tidal flat. All three verified present in the test box.
export BAY_VALUES="'Deep ocean/bay','Shallow ocean/bay','Tidal flat'"

# MARSH_VALUES: tidal marsh. 'Tidal slough' is included by judgement (channels cut through marsh);
#   it is not an SFEI statement. 'Tidal coastal lagoon' is deliberately in neither list.
export MARSH_VALUES="'Tidal marsh','Tidal slough'"
